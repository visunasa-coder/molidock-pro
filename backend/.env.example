APP_NAME="MoliDock Pro API"
ENVIRONMENT=development
API_BASE_URL=http://127.0.0.1:8010
FRONTEND_BASE_URL=http://127.0.0.1:5180
CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

DATABASE_URL=sqlite:///./molidock.db
STORAGE_DIR=storage
SECRET_KEY=replace-with-a-long-random-production-secret

VINA_BINARY=C:\Docking\Vina\vina.exe
OBABEL_BINARY=C:\Program Files\OpenBabel-3.1.1\obabel.exe
PREPARE_RECEPTOR_BINARY=
ALLOW_DEMO_DOCKING=false
MAX_UPLOAD_MB=75
MAX_PARALLEL_CPU=4

